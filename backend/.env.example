# Express server port. The Vite development proxy targets port 5000.
PORT=5000

# Comma-separated browser origins allowed by CORS in production.
# Example: https://sevasphere.example.gov.in,https://www.sevasphere.example.gov.in
CORS_ORIGINS=

# Optional. NODE_ENV=production disables the localhost CORS fallback.
# NODE_ENV=development

# Optional Lyzr (external assistant). Never commit real keys.
# LYZR_API_KEY=your_lyzr_api_key
# LYZR_AGENT_ID=your_lyzr_agent_id
# LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai

# BHASHINI API Credentials (Optional - for live multilingual translation & ASR)
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=
# BHASHINI_PIPELINE_ID=
# BHASHINI_ENDPOINT=

# API Setu Credentials (Optional - for live document verification)
# API_SETU_CLIENT_ID=
# API_SETU_API_KEY=
# API_SETU_BASE_URL=

# Optional semantic understanding provider hook for chatbot (not required).
# CHATBOT_SEMANTIC_PROVIDER=
